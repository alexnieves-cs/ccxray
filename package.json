{
  "name": "tknxray",
  "version": "0.1.0",
  "description": "Local-only CLI that explains where Claude Code tokens go. Reads your transcripts; no network calls.",
  "license": "MIT",
  "author": "Alex Nieves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexnieves-cs/ccxray.git"
  },
  "homepage": "https://github.com/alexnieves-cs/ccxray#readme",
  "bugs": {
    "url": "https://github.com/alexnieves-cs/ccxray/issues"
  },
  "keywords": [
    "claude-code",
    "tokens",
    "cache",
    "cli",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "tknxray": "bin/tknxray.js"
  },
  "files": [
    "bin",
    "dist",
    "hooks",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "scrub": "tsx scripts/scrub-fixture.ts",
    "probe": "tsx scripts/probe-format.ts",
    "fixtures": "tsx scripts/make-fixture.ts",
    "bench": "pnpm build && tsx bench/perf.ts --sizes 10mb,100mb",
    "bench:full": "pnpm build && tsx bench/perf.ts --sizes 10mb,100mb,1gb --clean",
    "bench:slim": "tsx bench/slim.ts",
    "my-sessions": "tsx bench/my-sessions.ts",
    "validate:real": "pnpm build && tsx scripts/validate-real.ts",
    "fp-check": "tsx scripts/fp-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.5",
    "fast-check": "3.23.2",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
